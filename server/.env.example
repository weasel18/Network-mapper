# Copy to .env and fill in.
# Shared team access key – make it long and random:  openssl rand -hex 24
SYNC_KEY=change-me-to-a-long-random-string
# Option A only: the domain that points at this server
DOMAIN=map.example.com
# Optional: UniFi cloud API key (unifi.ui.com -> API -> Create API key) so the browser version can show
# UniFi device status. It stays on this server; browsers never see it.
UNIFI_API_KEY=
